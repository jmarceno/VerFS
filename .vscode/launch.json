    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "X:",
                "-l",
                "jardelFS"
            ]
        },
        {
            "name": "Python: Current File - Debug Verbose",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "-d",
                "-v",
                "X:",
                "-l",
                "jardelFS"
            ]
        }
    ]
}